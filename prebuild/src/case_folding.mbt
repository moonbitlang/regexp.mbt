///|
async fn get_case_folding_mapping(input : String) -> Array[(Char, Char)] {
  let lines = read_unicode_lines(input, "CaseFolding.txt")

  // We only do simple case folding
  let regexp = @regexp.compile("^([0-9A-F]+);\\s+[CS];\\s+([0-9A-F]+);") catch {
    @regexp.RegexpError(err~, source_fragment~) =>
      fail(
        "Failed to compile regexp in case folding: \{err} at \{source_fragment}",
      )
  }
  let mappings = []
  for next in lines {
    let result = regexp.execute(next)
    if result.matched() {
      mappings.push(
        (
          result.get(1).unwrap()
          |> StringView::to_owned
          |> @string.parse_int(base=16)
          |> Int32::unsafe_to_char(),
          result.get(2).unwrap()
          |> StringView::to_owned
          |> @string.parse_int(base=16)
          |> Int32::unsafe_to_char(),
        ),
      )
    }
  }
  mappings
}

///|
async fn handle_case_folding(input : String, directory : String) -> Unit {
  let mappings = get_case_folding_mapping(input)

  // Compute reverse mapping
  let mut min = '\u{10FFFF}'
  let mut max = '\u{0000}'
  let reverse : Map[Char, Array[Char]] = Map([])
  for mapping in mappings {
    let (k, v) = mapping
    if k < min {
      min = k
    }
    if v < min {
      min = v
    }
    if k > max {
      max = k
    }
    if v > max {
      max = v
    }
    if reverse.get(v) is Some(array) {
      array.push(k)
    } else {
      reverse[v] = [k]
    }
  }

  let output = StringBuilder()

  // Start writing template
  write_line(
    output,
    (
      #|// generated by prebuild : just -d ./prebuild -f ./prebuild/justfile run
      #|
      #|///|
      #|let case_folding : Map[Char, Char] = {
    ),
  )
  for mapping in reverse.to_array() {
    let (key, mapping) = mapping
    let mut prev = key
    for ch in mapping {
      write_line(
        output,
        (
          $|  \{char_literal(prev)}: \{char_literal(ch)},
        ),
      )
      prev = ch
    }
    write_line(
      output,
      (
        $|  \{char_literal(prev)}: \{char_literal(key)},
      ),
    )
  }
  write_line(
    output,
    (
      $|}
      $|
      $|///|
      $|const MIN_FOLD : Char = \{char_literal(min)}
      $|
      $|///|
      $|const MAX_FOLD : Char = \{char_literal(max)}
    ),
  )
  @fs.write_file(
    "\{directory}/case_folding.mbt",
    output.to_string(),
    create_mode=CreateOrTruncate,
  )
}
